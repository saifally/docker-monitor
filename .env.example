# Docker Compose Project Name
COMPOSE_PROJECT_NAME=docker-monitor

# Monitoring Frequency
MONITOR_FREQUENCY=30s

# AWS Credentials (for CloudWatch logging)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Logging Configuration Examples (YAML format - much cleaner than JSON!)

# Option 1: Console only (default)
# For environment variables, use this format in docker-compose.yml:
# LOG_CONFIG: |
#   - driver: console
#     options:
#       format: json
#       level: info

# Option 2: Console + CSV
# LOG_CONFIG=|
#   - driver: console
#     options:
#       format: text
#   - driver: csv
#     output_path: /logs/metrics.csv

# Option 3: All local drivers
# LOG_CONFIG=|
#   - driver: console
#     options:
#       format: text
#   - driver: csv
#     output_path: /logs/metrics.csv
#   - driver: excel
#     output_path: /logs/metrics.xlsx
#     options:
#       sheet_name: Metrics

# Option 4: CloudWatch only
# LOG_CONFIG=|
#   - driver: cloudwatch
#     options:
#       log_group: /docker-monitor/production
#       log_stream: container-monitor
#       region: us-east-1
#       retention_days: "30"

# Option 5: Console + CloudWatch (Production Setup)
# LOG_CONFIG=|
#   - driver: console
#     options:
#       format: json
#   - driver: cloudwatch
#     options:
#       log_group: /docker-monitor/production
#       log_stream: container-monitor
#       region: us-east-1